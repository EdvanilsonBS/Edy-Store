# Variáveis de ambiente do back-end. NÃO envie o arquivo .env para o GitHub (veja .gitignore).
PORT=3333
NODE_ENV=development
# Troque por um texto longo e aleatório. Em produção o servidor se recusa a subir com o valor padrão.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Origens liberadas no CORS (separe várias por vírgula). 5173 é a porta do Vite.
# Ao publicar, inclua o endereço do site, ex.: http://localhost:5173,https://edy-store-peach.vercel.app
CORS_ORIGIN=http://localhost:5173
# Arquivo do banco SQLite (relativo à pasta backend/). Criado sozinho na 1ª execução.
# Se o seu .env antigo tinha data/db.json, troque para este valor (os dados antigos são importados).
DB_FILE=data/edi-store.db
# E-mail que será administrador (pode criar/editar/excluir produtos e gerenciar todos os pedidos).
# Cadastre-se com este e-mail pelo POST /api/auth/signup.
ADMIN_EMAIL=
# Máximo de tentativas de login/cadastro por IP a cada 15 minutos
AUTH_RATE_LIMIT=20
